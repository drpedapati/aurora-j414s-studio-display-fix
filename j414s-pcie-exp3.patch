+MODULE_PARM_DESC(tunnel_kernel_init, "Experimental J414s PCIe-C cold init (default off)");
+
+bool apple_pcie_tunnel_kernel_init_allowed(struct device_node *np)
+{
+	if (!of_device_is_compatible(np, "apple,t6000-pciec") ||
+	    !of_property_read_bool(np, "apple,j414s-pciec-exp3"))
+		return true;
+	return of_machine_is_compatible("apple,j414s") && READ_ONCE(tunnel_kernel_init);
+}
+EXPORT_SYMBOL_GPL(apple_pcie_tunnel_kernel_init_allowed);
